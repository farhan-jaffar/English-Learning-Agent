# Backend Production Environment Variables (Render / Railway / Neon)

# Django Core
DEBUG=False
SECRET_KEY=replace-with-a-random-secret-key-at-least-50-characters
ALLOWED_HOSTS=.onrender.com,.vercel.app,localhost,127.0.0.1

# Database (PostgreSQL string from Render, Neon.tech, or Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Celery & Redis (From free Upstash.com Redis)
CELERY_TASK_ALWAYS_EAGER=False
CELERY_BROKER_URL=rediss://default:your-upstash-password@your-upstash-endpoint.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:your-upstash-password@your-upstash-endpoint.upstash.io:6379

# Google Gemini API Key (From Google AI Studio - Free)
GEMINI_API_KEY=your-gemini-api-key

# Cross-Site Cookie & CORS (Points to your Vercel frontend)
CORS_ALLOWED_ORIGINS=https://your-english-app.vercel.app,http://localhost:5173
AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_SECURE=True
